[Unit]
Description=coffe — el reloj del pomodoro
Documentation=https://github.com/elyares/omarchy-coffe-pomo
# El daemon avisa por mako y despierta a waybar, así que no tiene sentido
# antes de que exista la sesión gráfica, y muere con ella.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/coffe daemon
Restart=on-failure
RestartSec=2
# Sin esto, un fallo repetido al arrancar (por ejemplo un socket que no se
# puede crear) reintentaría para siempre a dos segundos.
StartLimitBurst=5
StartLimitIntervalSec=60

[Install]
WantedBy=default.target
